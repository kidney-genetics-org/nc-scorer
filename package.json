{
  "name": "nc-scorer",
  "version": "3.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docs": "vitepress dev docs",
    "build": "npm run build:app && npm run build:docs",
    "build:app": "vite build",
    "build:docs": "vitepress build docs && npm run move:docs",
    "move:docs": "shx mkdir -p dist/docs && shx cp -r docs/.vitepress/dist/* dist/docs/",
    "preview": "vite preview",
    "preview:docs": "vitepress preview docs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "semantic-release": "semantic-release",
    "version": "node scripts/sync-citation-version.js",
    "commit": "git-cz",
    "prepare": "husky install"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "vitepress": {
      "vite": "$vite"
    },
    "glob@^13": "^14.0.6",
    "minimatch@^10": "^11.0.8"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@unhead/vue": "^3.4.3",
    "axios": "^1.21.1",
    "pinia": "^3.0.4",
    "shepherd.js": "^16.0.0",
    "variant-linker": "^4.0.0",
    "vue": "^3.5.45",
    "vue-router": "^4.5.0",
    "vuetify": "^3.8.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.25.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.0.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "sass": "^1.108.2",
    "semantic-release": "^26.0.1",
    "sharp": "^0.35.5",
    "shx": "^0.4.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.6",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  }
}
